{
  "name": "web-inspector",
  "version": "1.6.5",
  "description": "Chrome / Edge対応 Web技術検出＆セキュリティ診断ブラウザ拡張機能",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "advisories:fetch": "node scripts/advisories/fetch-upstream.mjs",
    "advisories:build": "node scripts/advisories/build-db.mjs",
    "advisories:sync": "npm run advisories:fetch && npm run advisories:build && npm run advisories:validate",
    "advisories:diff": "node scripts/advisories/diff-db.mjs",
    "advisories:validate": "node scripts/validate-advisories.mjs",
    "advisories:verify-nvd": "node scripts/verify-advisories-nvd.mjs",
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch",
    "test": "npm run typecheck && npm run test:links && vitest run",
    "test:watch": "vitest",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "npm run build && node scripts/test-e2e-smoke.mjs",
    "test-server": "node test-server/server.mjs",
    "spec:generate": "node scripts/generate-spec-catalog.mjs",
    "package": "npm run advisories:validate && npm run advisories:verify-nvd && npm run build && node scripts/package.mjs",
    "cws": "node scripts/cws-publish.mjs",
    "check:v1.6.6": "node scripts/dev/check-v1.6.6.mjs"
  },
  "keywords": [
    "chrome-extension",
    "security-scanner",
    "technology-profiler",
    "wappalyzer-alternative",
    "manifest-v3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
